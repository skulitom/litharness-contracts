{
  "$defs": {
    "ContextItemKind": {
      "enum": [
        "exact_prose",
        "plan",
        "fact",
        "event",
        "thread",
        "summary",
        "finding",
        "author_rule",
        "unknown"
      ],
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": true,
      "properties": {
        "anchor_after": {
          "type": "string"
        },
        "anchor_before": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "end": {
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ResourceRef"
        },
        "start": {
          "type": "integer"
        }
      },
      "required": [
        "source",
        "start",
        "end",
        "content_sha256"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "StateAuthority": {
      "enum": [
        "author_locked",
        "accepted_canon",
        "derived",
        "proposed",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "https://litharness.dev/schemas/context_item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authority": {
      "$ref": "#/$defs/StateAuthority"
    },
    "confidence": {
      "type": "number"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/ResourceRef"
      },
      "type": "array"
    },
    "item_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ContextItemKind"
    },
    "pov_visibility": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "type": "array"
    },
    "scores": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/ResourceRef"
    },
    "story_scope": {
      "$ref": "#/$defs/ResourceRef"
    },
    "text": {
      "type": "string"
    },
    "token_count": {
      "type": "integer"
    }
  },
  "required": [
    "item_id",
    "kind",
    "source",
    "text",
    "token_count"
  ],
  "title": "ContextItem",
  "type": "object"
}
