{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "config_digest": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "source_revisions": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_kind",
        "created_at",
        "actor",
        "tool"
      ],
      "type": "object"
    },
    "ChangeActor": {
      "enum": [
        "author",
        "system",
        "import",
        "unknown"
      ],
      "type": "string"
    },
    "ChangeOpKind": {
      "enum": [
        "replace_span",
        "insert",
        "delete",
        "move",
        "rename",
        "reorder",
        "split",
        "merge",
        "unknown"
      ],
      "type": "string"
    },
    "ChangeOperation": {
      "additionalProperties": true,
      "properties": {
        "after_hash": {
          "type": "string"
        },
        "after_version": {
          "type": "string"
        },
        "before_hash": {
          "type": "string"
        },
        "before_version": {
          "type": "string"
        },
        "detail": {
          "additionalProperties": {},
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/ChangeOpKind"
        },
        "logical_source_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "logical_source_id"
      ],
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": true,
      "properties": {
        "anchor_after": {
          "type": "string"
        },
        "anchor_before": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "end": {
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ResourceRef"
        },
        "start": {
          "type": "integer"
        }
      },
      "required": [
        "source",
        "start",
        "end",
        "content_sha256"
      ],
      "type": "object"
    },
    "ExtractedChange": {
      "additionalProperties": true,
      "properties": {
        "after": {},
        "before": {},
        "confidence": {
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ExtractedChangeKind"
        },
        "predicate": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ExtractedChangeKind": {
      "enum": [
        "fact_changed",
        "entity_renamed",
        "event_moved",
        "event_added",
        "event_removed",
        "plan_changed",
        "pov_changed",
        "rule_changed",
        "surface_only",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "ToolIdentity": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://litharness.dev/schemas/change_set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ChangeActor"
    },
    "base_revision": {
      "type": "string"
    },
    "change_set_id": {
      "type": "string"
    },
    "declared_intent": {
      "type": "string"
    },
    "extracted_changes": {
      "items": {
        "$ref": "#/$defs/ExtractedChange"
      },
      "type": "array"
    },
    "idempotency_key": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/ChangeOperation"
      },
      "type": "array"
    },
    "preservation_constraints": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "target_branch": {
      "type": "string"
    }
  },
  "required": [
    "meta",
    "change_set_id",
    "base_revision",
    "target_branch",
    "actor",
    "operations",
    "idempotency_key"
  ],
  "title": "ChangeSet",
  "type": "object"
}
