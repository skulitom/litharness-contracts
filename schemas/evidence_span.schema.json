{
  "$defs": {
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    }
  },
  "$id": "https://litharness.dev/schemas/evidence_span.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "anchor_after": {
      "type": "string"
    },
    "anchor_before": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string"
    },
    "end": {
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/ResourceRef"
    },
    "start": {
      "type": "integer"
    }
  },
  "required": [
    "source",
    "start",
    "end",
    "content_sha256"
  ],
  "title": "EvidenceSpan",
  "type": "object"
}
