{
  "$defs": {
    "EvidenceSpan": {
      "additionalProperties": true,
      "properties": {
        "anchor_after": {
          "type": "string"
        },
        "anchor_before": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "end": {
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ResourceRef"
        },
        "start": {
          "type": "integer"
        }
      },
      "required": [
        "source",
        "start",
        "end",
        "content_sha256"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "StateAuthority": {
      "enum": [
        "author_locked",
        "accepted_canon",
        "derived",
        "proposed",
        "unknown"
      ],
      "type": "string"
    },
    "StateRecordKind": {
      "enum": [
        "assertion",
        "event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "unknown"
      ],
      "type": "string"
    },
    "StoryPosition": {
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "order_key": {
          "type": "string"
        }
      },
      "required": [
        "order_key"
      ],
      "type": "object"
    }
  },
  "$id": "https://litharness.dev/schemas/state_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authority": {
      "$ref": "#/$defs/StateAuthority"
    },
    "confidence": {
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/StateRecordKind"
    },
    "note": {
      "type": "string"
    },
    "object_ref": {
      "type": "string"
    },
    "pov_visibility": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "predicate": {
      "type": "string"
    },
    "predicate_registry_version": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "story_position": {
      "$ref": "#/$defs/StoryPosition"
    },
    "subject": {
      "type": "string"
    },
    "value": {}
  },
  "required": [
    "record_id",
    "kind",
    "subject",
    "predicate"
  ],
  "title": "StateRecord",
  "type": "object"
}
