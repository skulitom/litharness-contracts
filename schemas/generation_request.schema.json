{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "config_digest": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "source_revisions": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_kind",
        "created_at",
        "actor",
        "tool"
      ],
      "type": "object"
    },
    "GenerationKind": {
      "enum": [
        "scene_draft",
        "continuation",
        "repair",
        "structured",
        "unknown"
      ],
      "type": "string"
    },
    "GenerationParams": {
      "additionalProperties": true,
      "properties": {
        "max_tokens": {
          "type": "integer"
        },
        "seed": {
          "type": "integer"
        },
        "stop": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "ModelIdentifier": {
      "additionalProperties": true,
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "request_profile": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        },
        "version_or_digest": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "ToolIdentity": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://litharness.dev/schemas/generation_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "context_packet_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/GenerationKind"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "model": {
      "$ref": "#/$defs/ModelIdentifier"
    },
    "output_schema_id": {
      "type": "string"
    },
    "params": {
      "$ref": "#/$defs/GenerationParams"
    },
    "request_id": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ResourceRef"
    }
  },
  "required": [
    "meta",
    "request_id",
    "kind",
    "target",
    "model",
    "idempotency_key"
  ],
  "title": "GenerationRequest",
  "type": "object"
}
