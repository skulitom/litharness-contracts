{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "config_digest": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "source_revisions": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_kind",
        "created_at",
        "actor",
        "tool"
      ],
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": true,
      "properties": {
        "anchor_after": {
          "type": "string"
        },
        "anchor_before": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "end": {
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ResourceRef"
        },
        "start": {
          "type": "integer"
        }
      },
      "required": [
        "source",
        "start",
        "end",
        "content_sha256"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "StateAuthority": {
      "enum": [
        "author_locked",
        "accepted_canon",
        "derived",
        "proposed",
        "unknown"
      ],
      "type": "string"
    },
    "StateRecord": {
      "additionalProperties": true,
      "properties": {
        "authority": {
          "$ref": "#/$defs/StateAuthority"
        },
        "confidence": {
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StateRecordKind"
        },
        "note": {
          "type": "string"
        },
        "object_ref": {
          "type": "string"
        },
        "pov_visibility": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "predicate": {
          "type": "string"
        },
        "predicate_registry_version": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "story_position": {
          "$ref": "#/$defs/StoryPosition"
        },
        "subject": {
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "record_id",
        "kind",
        "subject",
        "predicate"
      ],
      "type": "object"
    },
    "StateRecordKind": {
      "enum": [
        "assertion",
        "event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "unknown"
      ],
      "type": "string"
    },
    "StoryPosition": {
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "order_key": {
          "type": "string"
        }
      },
      "required": [
        "order_key"
      ],
      "type": "object"
    },
    "ToolIdentity": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://litharness.dev/schemas/state_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "as_of": {
      "$ref": "#/$defs/StoryPosition"
    },
    "book_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/StateRecord"
      },
      "type": "array"
    },
    "revision_id": {
      "type": "string"
    }
  },
  "required": [
    "meta",
    "book_id",
    "branch_id",
    "revision_id",
    "records"
  ],
  "title": "StateSnapshot",
  "type": "object"
}
