{
  "$defs": {
    "ApprovalMode": {
      "enum": [
        "automatic",
        "review_after",
        "author_required",
        "never_automatic",
        "unknown"
      ],
      "type": "string"
    },
    "ArtifactMeta": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "config_digest": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "source_revisions": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_kind",
        "created_at",
        "actor",
        "tool"
      ],
      "type": "object"
    },
    "ImpactClass": {
      "enum": [
        "invalidate_recompute",
        "structured_update",
        "repair_candidate",
        "review_warning",
        "preserve",
        "no_action",
        "unknown"
      ],
      "type": "string"
    },
    "ImpactItem": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "type": "number"
        },
        "impact_class": {
          "$ref": "#/$defs/ImpactClass"
        },
        "reason": {
          "type": "string"
        },
        "reason_paths": {
          "items": {
            "items": {
              "$ref": "#/$defs/ImpactPathEdge"
            },
            "type": "array"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "target",
        "impact_class"
      ],
      "type": "object"
    },
    "ImpactPathEdge": {
      "additionalProperties": true,
      "properties": {
        "authority": {
          "type": "string"
        },
        "edge_type": {
          "type": "string"
        },
        "from_ref": {
          "$ref": "#/$defs/ResourceRef"
        },
        "to_ref": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "edge_type",
        "from_ref",
        "to_ref"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "RevisionStep": {
      "additionalProperties": true,
      "properties": {
        "action": {
          "$ref": "#/$defs/StepAction"
        },
        "approval": {
          "$ref": "#/$defs/ApprovalMode"
        },
        "confidence": {
          "type": "number"
        },
        "finding_id": {
          "type": "string"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preservation_constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "step_id",
        "target",
        "action",
        "approval"
      ],
      "type": "object"
    },
    "StepAction": {
      "enum": [
        "recompute",
        "propose_repair",
        "structured_update",
        "warn",
        "no_op",
        "unknown"
      ],
      "type": "string"
    },
    "ToolIdentity": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://litharness.dev/schemas/revision_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "base_revision": {
      "type": "string"
    },
    "change_set_id": {
      "type": "string"
    },
    "estimated_cost": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "excluded_candidates": {
      "items": {
        "$ref": "#/$defs/ImpactItem"
      },
      "type": "array"
    },
    "graph_version": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "plan_id": {
      "type": "string"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/RevisionStep"
      },
      "type": "array"
    }
  },
  "required": [
    "meta",
    "plan_id",
    "base_revision",
    "change_set_id",
    "steps"
  ],
  "title": "RevisionPlan",
  "type": "object"
}
