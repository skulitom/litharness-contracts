{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "config_digest": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "source_revisions": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_kind",
        "created_at",
        "actor",
        "tool"
      ],
      "type": "object"
    },
    "GateKind": {
      "enum": [
        "shape",
        "integrity",
        "craft",
        "budget",
        "unknown"
      ],
      "type": "string"
    },
    "GateResult": {
      "additionalProperties": true,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "calibration_id": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/GateKind"
        },
        "passed": {
          "type": "boolean"
        },
        "rule_or_critic_id": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "verdict_source": {
          "$ref": "#/$defs/VerdictSource"
        },
        "vetoes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "gate",
        "rule_or_critic_id",
        "passed"
      ],
      "type": "object"
    },
    "PolicyOutcome": {
      "enum": [
        "accept",
        "retry",
        "repair",
        "regenerate",
        "park",
        "escalate",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "ToolIdentity": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "VerdictSource": {
      "enum": [
        "deterministic",
        "calibrated_critic",
        "uncalibrated_critic",
        "human",
        "model_self_report",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "https://litharness.dev/schemas/policy_decision_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "attempt": {
      "type": "integer"
    },
    "cost_usd": {
      "type": "number"
    },
    "decided_at": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "escalation_id": {
      "type": "string"
    },
    "fell_back_from": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "type": "array"
    },
    "invocations": {
      "type": "integer"
    },
    "job_id": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "model": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/PolicyOutcome"
    },
    "policy_config_digest": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "resulting_revision_id": {
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/ResourceRef"
    },
    "total_tokens": {
      "type": "integer"
    }
  },
  "required": [
    "meta",
    "decision_id",
    "outcome"
  ],
  "title": "PolicyDecisionRecord",
  "type": "object"
}
