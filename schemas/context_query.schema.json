{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "causation_id": {
          "type": "string"
        },
        "config_digest": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "source_revisions": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "type": "array"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_kind",
        "created_at",
        "actor",
        "tool"
      ],
      "type": "object"
    },
    "ContextOperation": {
      "enum": [
        "draft_scene",
        "continue",
        "evaluate",
        "repair",
        "plan",
        "answer",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceKind": {
      "enum": [
        "manuscript_book",
        "manuscript_part",
        "manuscript_chapter",
        "manuscript_scene",
        "manuscript_block",
        "plan",
        "entity",
        "assertion",
        "state_event",
        "relationship",
        "knowledge",
        "thread",
        "world_rule",
        "summary",
        "embedding",
        "context_packet",
        "finding",
        "graph_node",
        "generation_candidate",
        "revision_plan",
        "export_artifact",
        "job",
        "unknown"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "properties": {
        "book_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "logical_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "book_id",
        "branch_id",
        "logical_id",
        "kind"
      ],
      "type": "object"
    },
    "StoryPosition": {
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "order_key": {
          "type": "string"
        }
      },
      "required": [
        "order_key"
      ],
      "type": "object"
    },
    "ToolIdentity": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://litharness.dev/schemas/context_query.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "exclusions": {
      "items": {
        "$ref": "#/$defs/ResourceRef"
      },
      "type": "array"
    },
    "hard_requirements": {
      "items": {
        "$ref": "#/$defs/ResourceRef"
      },
      "type": "array"
    },
    "intent": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "model_context_limit": {
      "type": "integer"
    },
    "operation": {
      "$ref": "#/$defs/ContextOperation"
    },
    "policy_version": {
      "type": "string"
    },
    "pov_character_id": {
      "type": "string"
    },
    "query_id": {
      "type": "string"
    },
    "referenced_entities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "referenced_threads": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "story_time_cutoff": {
      "$ref": "#/$defs/StoryPosition"
    },
    "target": {
      "$ref": "#/$defs/ResourceRef"
    },
    "token_budget": {
      "type": "integer"
    }
  },
  "required": [
    "meta",
    "query_id",
    "operation",
    "target",
    "token_budget"
  ],
  "title": "ContextQuery",
  "type": "object"
}
